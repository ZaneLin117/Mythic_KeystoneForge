WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Existing public ranking snapshot used by the Node sync/download scripts.
RANKINGS_BASE_URL=https://zanelin117.github.io/Mythic_KeystoneForge
# Public base URL used by the browser. The Pages workflows configure this automatically.
# Set to http://localhost:5173 to preview locally generated rankings (src/data/sampleRoutes/<dungeon>/)
# served by the dev server, instead of the published production data.
VITE_RANKINGS_BASE_URL=http://localhost:5173

# Online features are disabled by default so a local fork does not use Threechest infrastructure.
# Enable only after replacing the Firebase, sharing API, RTC and analytics configuration.
VITE_ENABLE_CLOUD=false
VITE_ENABLE_COLLAB=false
VITE_ENABLE_ROUTE_SHARING=false
VITE_ENABLE_ANALYTICS=false
VITE_STATIC_DEPLOYMENT=false
