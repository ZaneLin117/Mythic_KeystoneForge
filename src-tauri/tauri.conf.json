{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Keystone Forge",
  "version": "0.1.0",
  "identifier": "io.github.zanelin117.keystoneforge",
  "build": {
    "beforeDevCommand": "corepack yarn@1.22.22 dev:desktop:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack yarn@1.22.22 build:desktop:web",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Keystone Forge",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
